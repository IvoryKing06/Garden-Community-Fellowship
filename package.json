{
  "name": "garden-community-fellowship",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sync:sanity && npm run validate:content && tsc -b && vite build && vite build --ssr src/prerender.tsx --outDir .ssr && node .ssr/prerender.js",
    "lint": "oxlint",
    "sync:sanity": "node scripts/pull-sanity-content.mjs",
    "seed:sanity": "node scripts/create-sanity-seed.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test:content": "node --test scripts/content-validation.test.mjs scripts/sanity-content.test.mjs",
    "preview": "vite preview",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
